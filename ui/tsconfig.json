{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"jsx": "preserve",
		"types": ["vite/client"],
		"skipLibCheck": true,
		"noEmit": true,
		"lib": [
			"ES2022",
			"DOM"
		]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.vue",
		"tests/**/*"
	]
}
