{
	// HIF 本战 Day1 仅观察入口：先确认页面，不发送任何输入。
	"test_hif_day1_entry": {
		"recognition": {"type": "DirectHit", "param": {}},
		"action": {"type": "DoNothing", "param": {}},
		"timeout": 10000,
		"next": ["test_hif_day1_schedule_flag"],
		"on_error": ["test_hif_observe_stop"]
	},
	// Day1 日数锚点：当前页必须明确显示 6 日，避免把其他本战日误当首日。
	"test_hif_day1_remaining_days_flag": {
		"recognition": {
			"type": "OCR",
			"param": {"expected": [".*6日.*"], "roi": [
					40,
					90,
					150,
					70
				]}
		},
		"action": {"type": "DoNothing", "param": {}},
		"timeout": 10000,
		"on_error": ["test_hif_observe_stop"]
	},
	// Day1 场景闸：HIF 标题和 6 日必须同时命中；通过后仍只观察并停止。
	"test_hif_day1_schedule_flag": {
		"recognition": {
			"type": "And",
			"param": {"all_of": [
					"test_hif_day3_title_flag",
					"test_hif_day1_remaining_days_flag"
				], "box_index": 0}
		},
		"action": {"type": "DoNothing", "param": {}},
		"timeout": 10000,
		"next": ["test_hif_observe_stop"],
		"on_error": ["test_hif_observe_stop"]
	},
	// Day1 单步课程测试入口：仅从当前的本战准备页启动；不会尝试恢复或重复点击。
	"test_hif_day1_select_entry": {
		"recognition": {"type": "DirectHit", "param": {}},
		"action": {"type": "DoNothing", "param": {}},
		"timeout": 10000,
		"next": ["test_hif_day1_select_schedule_flag"],
		"on_error": ["test_hif_observe_stop"]
	},
	// 单步前安全闸：复用 HIF 标题与 Day1 日数锚点，任一缺失就停止。
	"test_hif_day1_select_schedule_flag": {
		"recognition": {
			"type": "And",
			"param": {"all_of": [
					"test_hif_day3_title_flag",
					"test_hif_day1_remaining_days_flag"
				], "box_index": 0}
		},
		"action": {"type": "DoNothing", "param": {}},
		"timeout": 10000,
		"next": ["test_hif_day1_select_vo_once"],
		"on_error": ["test_hif_observe_stop"]
	},
	// 唯一允许的输入：完整识别 Vo/Da/Vi 后仅选择 Vo 一次；已选态或未知后态均安全停止。
	"test_hif_day1_select_vo_once": {
		"recognition": {"type": "DirectHit", "param": {}},
		"action": {
			"type": "Custom",
			"param": {
				"custom_action": "ProduceChooseHIFEventAuto",
				"custom_action_param": {"preset_id": "rinami_good_condition_safe", "day1_lesson": "Vo", "execution_mode": "single_step"}
			}
		},
		"next": ["test_hif_observe_stop"],
		"on_error": ["test_hif_observe_stop"]
	},
