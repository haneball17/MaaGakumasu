{
  "$id": "https://maagakumasu.local/schemas/term.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_assertion_ids": { "items": { "type": "string" }, "type": "array" },
    "code": { "pattern": "^[a-z_]+:[a-z0-9_]+$", "type": "string" },
    "entity_id": { "pattern": "^term:[0-9a-f-]{36}$", "type": "string" },
    "names": { "additionalProperties": { "minLength": 1, "type": "string" }, "minProperties": 1, "type": "object" },
    "schema_version": { "const": "2.0" },
    "source_keys": { "items": { "type": "object" }, "type": "array" }
  },
  "required": ["schema_version", "entity_id", "code", "names", "source_keys", "canonical_assertion_ids"],
  "title": "Controlled term",
  "type": "object"
}
